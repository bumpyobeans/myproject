---
import Base from '../layouts/Base.astro';
import { getPublicPosts } from '../lib/posts';
import { categories, getCategoryByName } from '../lib/categories';

const posts = await getPublicPosts();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '범표원두 노트',
    url: Astro.site,
    description: '범표원두가 20년째 커피를 볶으며 쓰는 노트.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: '범표원두',
    url: Astro.site,
    description: '20년 스페셜티 커피 로스터리. 네이버 스마트스토어, 카페24, 인스타그램에서 만날 수 있습니다.',
  },
];
---

<Base title="범표원두 노트" path="/" jsonLd={jsonLd}>
  <div class="pill-list">
    <a class="pill active" href="/">전체</a>
    {categories.map((c) => (
      <a class="pill" href={`/category/${c.slug}/`}>{c.name}</a>
    ))}
  </div>

  {posts.length === 0 ? (
    <p class="empty">아직 글이 없습니다.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => {
        const cat = getCategoryByName(post.data.category);
        return (
          <li class="post-card">
            {post.data.image && (
              <div class="post-thumb">
                <img src={post.data.image} alt="" loading="lazy" />
              </div>
            )}
            <div class="post-body">
              <a class="post-title" href={`/posts/${post.id}/`}>{post.data.title}</a>
              <p class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('ko-KR')}
                </time>
                {' · '}
                {cat ? <a href={`/category/${cat.slug}/`}>{cat.name}</a> : post.data.category}
              </p>
              {post.data.description && <p class="post-description">{post.data.description}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  )}
</Base>
