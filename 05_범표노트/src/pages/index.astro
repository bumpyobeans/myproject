---
import Base from '../layouts/Base.astro';
import { getPublicPosts } from '../lib/posts';
import { categories, getCategoryByName } from '../lib/categories';

const posts = await getPublicPosts();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '범표원두 노트',
    url: Astro.site,
    description: '범표원두가 20년째 커피를 볶으며 쓰는 노트.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: '범표원두',
    url: Astro.site,
    description: '20년 스페셜티 커피 로스터리. 네이버 스마트스토어, 카페24, 인스타그램에서 만날 수 있습니다.',
  },
];
---

<Base title="범표원두 노트" path="/" jsonLd={jsonLd}>
  <section class="hero">
    <img src="/images/hero-team.jpg" alt="범표원두 직원들이 호랑이 로고 티셔츠를 입고 있는 모습" class="hero-bg" />
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <p class="hero-eyebrow">BUMPYO BEANS · SINCE 2004</p>
      <h1 class="hero-title">20년째, 정직하게 볶은 커피</h1>
      <p class="hero-subtitle">범표원두가 직접 로스팅한 원두와, 그 안의 이야기를 만나보세요.</p>
      <div class="hero-buttons">
        <a href="#post-list" class="hero-btn hero-btn-primary">글 보러가기</a>
        <a href="https://coffee.bumpyobeans.shop" target="_blank" rel="noopener noreferrer" class="hero-btn hero-btn-outline">커피 추천 받기</a>
        <a href="/contact/" class="hero-btn hero-btn-outline">협업 문의</a>
      </div>
    </div>
  </section>

  <section class="stores">
    <h2 class="stores-title">범표원두 매장</h2>
    <div class="stores-chips" id="stores-chips"></div>
    <div id="stores-map" class="stores-map"></div>
    <p class="stores-note">📍 범표원두팩토리(로스팅공장)에서도 원두를 직접 구매하실 수 있어요. 주변 제조업체의 납품 문의도 환영합니다.</p>
  </section>

  <div class="pill-list">
    <a class="pill active" href="/">전체</a>
    {categories.map((c) => (
      <a class="pill" href={`/category/${c.slug}/`}>{c.name}</a>
    ))}
  </div>

  {posts.length === 0 ? (
    <p class="empty">아직 글이 없습니다.</p>
  ) : (
    <ul class="post-list" id="post-list">
      {posts.map((post) => {
        const cat = getCategoryByName(post.data.category);
        return (
          <li class="post-card">
            {post.data.image && (
              <div class="post-thumb">
                <img src={post.data.image} alt="" loading="lazy" />
              </div>
            )}
            <div class="post-body">
              <a class="post-title" href={`/posts/${post.id}/`}>{post.data.title}</a>
              <p class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('ko-KR')}
                </time>
                {' · '}
                {cat ? <a href={`/category/${cat.slug}/`}>{cat.name}</a> : post.data.category}
              </p>
              {post.data.description && <p class="post-description">{post.data.description}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  )}
</Base>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" is:inline></script>
<script is:inline>
  (function () {
    var STORES = [
      {
        name: '구리갈매점',
        type: '직영 · 본점',
        address: '경기 구리시 갈매순환로204번길 51-14, 1층(갈매동)',
        lat: 37.63896,
        lng: 127.12357,
        url: null,
      },
      {
        name: '별내점',
        type: '직영',
        address: '경기 남양주시 별내2로 117 가동 1층',
        lat: 37.64540,
        lng: 127.12252,
        url: 'https://map.naver.com/p/entry/place/1192703168',
      },
      {
        name: '역삼점',
        type: '직영',
        address: '서울 강남구 테헤란로37길 42 지하1층',
        lat: 37.50287,
        lng: 127.04082,
        url: 'https://map.naver.com/p/entry/place/1680652900',
      },
      {
        name: '다산정약용도서관점',
        type: '가맹 1호점',
        address: '경기 남양주시 다산동, 다산중앙로82번안길 143-9 1층',
        lat: 37.61292,
        lng: 127.16703,
        url: 'https://naver.me/5lf3Tsks',
      },
      {
        name: '수서점',
        type: '가맹 · 10월 말 오픈 예정',
        address: '서울 강남구 수서동 713 수서현대벤처빌 1층 1162호',
        lat: 37.48809,
        lng: 127.10173,
        url: null,
      },
      {
        name: '범표원두팩토리',
        type: '로스팅공장',
        address: '경기 구리시 갈매순환로166번길 46 금강펜테리움IX타워 지식산업센터동 3층 03-006호',
        lat: 37.63582,
        lng: 127.12480,
        url: 'https://naver.me/FzsVjpZN',
        note: '원두 직접 구매 가능 · 제조업체 납품 문의 환영',
      },
    ];

    var mapEl = document.getElementById('stores-map');
    var chipsEl = document.getElementById('stores-chips');
    if (!mapEl || !chipsEl || typeof L === 'undefined') return;

    var map = L.map(mapEl);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    var markers = STORES.map(function (s) {
      var html =
        '<strong>' + escapeHtml(s.name) + '</strong><br>' +
        escapeHtml(s.type) + '<br>' +
        escapeHtml(s.address) +
        (s.note ? '<br><em>' + escapeHtml(s.note) + '</em>' : '') +
        (s.url ? '<br><a href="' + s.url + '" target="_blank" rel="noopener noreferrer">네이버 플레이스에서 보기</a>' : '');
      var marker = L.marker([s.lat, s.lng]).addTo(map).bindPopup(html);
      return marker;
    });

    var group = L.featureGroup(markers);
    map.fitBounds(group.getBounds().pad(0.25));

    STORES.forEach(function (s, i) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pill store-chip';
      btn.textContent = s.name;
      btn.addEventListener('click', function () {
        map.setView([s.lat, s.lng], 15);
        markers[i].openPopup();
      });
      chipsEl.appendChild(btn);
    });
  })();
</script>
