---
import Base from '../layouts/Base.astro';
---

<Base title="협업 문의" path="/contact/" description="범표원두와 협업·입점·제휴를 원하시는 분은 이 페이지에서 문의를 남겨주세요.">
  <article>
    <h1>협업 문의</h1>
    <div class="content">
      <p>입점 제안, 원두 납품·협업, 브랜드 콜라보, 미디어 문의 등 범표원두와 함께하고 싶으신 분은 아래 양식을 남겨주세요. 확인 후 남겨주신 연락처나 이메일로 답변드립니다.</p>
    </div>

    <form id="contact-form" class="contact-form">
      <p class="contact-error" id="contact-error" hidden></p>
      <p class="contact-success" id="contact-success" hidden>문의가 접수됐습니다. 빠른 시일 내에 연락드리겠습니다.</p>

      <label class="contact-field">
        <span>이름 *</span>
        <input type="text" name="name" id="contact-name" required maxlength="50" />
      </label>

      <label class="contact-field">
        <span>연락처</span>
        <input type="text" name="contact" id="contact-phone" placeholder="휴대폰 번호 (선택)" />
      </label>

      <label class="contact-field">
        <span>이메일 *</span>
        <input type="email" name="email" id="contact-email" required />
      </label>

      <label class="contact-field">
        <span>소속·업체명</span>
        <input type="text" name="company" id="contact-company" placeholder="선택" />
      </label>

      <label class="contact-field">
        <span>문의 유형 *</span>
        <select name="type" id="contact-type" required>
          <option value="가맹/매장 입점">가맹/매장 입점</option>
          <option value="원두 납품·협업">원두 납품·협업</option>
          <option value="브랜드 콜라보·제휴">브랜드 콜라보·제휴</option>
          <option value="미디어/인터뷰">미디어/인터뷰</option>
          <option value="기타">기타</option>
        </select>
      </label>

      <label class="contact-field">
        <span>문의 내용 *</span>
        <textarea name="message" id="contact-message" rows="6" required maxlength="3000" placeholder="어떤 협업을 원하시는지 편하게 적어주세요."></textarea>
      </label>

      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" />

      <button type="submit" id="contact-submit">문의 보내기</button>
    </form>
  </article>
</Base>

<script src="/config.js" is:inline></script>
<script src="/contact.js" is:inline></script>
<script is:inline>
  (function () {
    var formEl = document.getElementById('contact-form');
    var submitEl = document.getElementById('contact-submit');
    var errorEl = document.getElementById('contact-error');
    var successEl = document.getElementById('contact-success');
    var hpEl = formEl.querySelector('input[name="website"]');

    function showError(message) {
      successEl.hidden = true;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function hideMessages() {
      errorEl.hidden = true;
      successEl.hidden = true;
    }

    formEl.addEventListener('submit', function (event) {
      event.preventDefault();
      hideMessages();

      if (hpEl.value) {
        formEl.reset();
        return;
      }

      if (!window.NOTE_CONTACT) {
        showError('문의 기능을 사용할 수 없어요.');
        return;
      }

      var data = {
        name: document.getElementById('contact-name').value.trim(),
        contact: document.getElementById('contact-phone').value.trim() || null,
        email: document.getElementById('contact-email').value.trim(),
        company: document.getElementById('contact-company').value.trim() || null,
        type: document.getElementById('contact-type').value,
        message: document.getElementById('contact-message').value.trim()
      };

      if (!data.name || !data.email || !data.message) return;

      submitEl.disabled = true;

      Promise.resolve(window.NOTE_CONTACT.postInquiry(data))
        .then(function (result) {
          if (result && result.error) {
            showError('문의 접수에 실패했어요. 잠시 후 다시 시도해주세요.');
            return;
          }
          formEl.reset();
          successEl.hidden = false;
        })
        .catch(function () {
          showError('문의 접수에 실패했어요. 잠시 후 다시 시도해주세요.');
        })
        .finally(function () {
          submitEl.disabled = false;
        });
    });
  })();
</script>
